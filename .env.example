# Paste your OpenRouter key below (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Claude Sonnet 5.5 on OpenRouter (adjust slug if OpenRouter lists it differently)
MODEL_NAME=anthropic/claude-sonnet-5.5
# Embeddings (spec: BAAI/bge-large-en-v1.5, 1024-dim). Use bge-small-en-v1.5 for a lighter download.
EMBED_MODEL=BAAI/bge-large-en-v1.5
